# Copy to .env and fill in (never commit .env)

# Provider: gemini | openrouter
LLM_PROVIDER=openrouter

# --- OpenRouter (recommended if you have an OpenRouter key) ---
OPENROUTER_API_KEY=
# OpenRouter model ids use a vendor prefix:
GEMINI_MODEL=google/gemini-2.5-flash
# Set to 1 only after OpenRouter balance ≥ $0.50 (native audio). Default: free WAV STT.
# OPENROUTER_AUDIO=0

# --- Google AI Studio / Gemini native (alternative) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alternative to GEMINI_API_KEY
# GEMINI_MODEL=gemini-3.8-flash
# LLM_MODEL=gemini-3.8-flash   # deprecated alias
